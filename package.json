{
  "name": "nifpass",
  "version": "0.1.0",
  "private": true,
  "description": "NIFPass by GoGentik - share your Portuguese NIF with merchants by scanning a QR code.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "next build",
    "start": "tsx server/index.ts --prod",
    "backend": "tsx server/standalone.ts",
    "start:backend": "tsx server/standalone.ts --prod",
    "frontend": "next dev -H 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "next": "^15.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
