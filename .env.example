# ---- Server (combined Next.js + Socket.IO, or standalone backend) ----
PORT=3000
HOST=0.0.0.0
# Set to "true" when running behind a reverse proxy / PaaS (Render, Railway, Fly, ngrok...)
# so rate limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# Optional: serve HTTPS directly (e.g. local LAN testing with mkcert certificates).
# HTTPS_KEY_FILE=./certs/key.pem
# HTTPS_CERT_FILE=./certs/cert.pem

# Standalone backend only: comma-separated list of allowed frontend origins.
# CORS_ORIGINS=https://nifpass.example.com

# ---- Frontend (public, embedded in the browser bundle - never put secrets here) ----
# Public base URL used inside merchant QR codes. Must NOT be localhost.
# Defaults to the URL the merchant dashboard is opened on.
# NEXT_PUBLIC_APP_URL=https://nifpass.example.com

# Only needed when the backend is deployed separately from the frontend.
# Defaults to the same origin as the page.
# NEXT_PUBLIC_SOCKET_URL=https://api.nifpass.example.com
