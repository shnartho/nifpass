# Copy to .env.local for local testing; set the same variables in Vercel for deployment.

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Ably API key with Publish, Subscribe, Presence and Channel metadata on channels "nifpass:*".
ABLY_API_KEY=

# ---- Public (embedded in the browser bundle - never put secrets here) ----
# Public base URL used inside store QR codes. Must NOT be localhost.
# Defaults to the URL the store dashboard is opened on.
# NEXT_PUBLIC_APP_URL=https://nifpass.gogentik.com
